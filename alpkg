# ─── Utilities ─────────────────────────────────────────────

download() {
    local url="$1" out="$2"
    if command -v curl >/dev/null 2>&1; then curl -fsSL "$url" -o "$out"
    elif command -v wget >/dev/null 2>&1; then wget -q "$url" -O "$out"
    else echo "Error: need curl or wget"; exit 1; fi
}

repo_index_path() {
    local rname="$1"
    echo "$CACHE/index-$rname.json"
}

fetch_index() {
    mkdir -p "$CACHE" 2>/dev/null
    local total=0
    for entry in "${REPOS[@]}"; do
        local rname="${entry%%|*}"
        local rurl="${entry#*|}"
        local idx_path
        idx_path=$(repo_index_path "$rname")
        echo "Fetching alpkg index from $rname ($rurl)..." >&2
        if download "$rurl/index.json" "$idx_path"; then
            local count
            count=$(grep -c '"name"' "$idx_path" 2>/dev/null || echo 0)
            echo "  OK ($count packages)" >&2
            total=$((total + count))
        else
            echo "  Warning: failed to fetch index from $rname" >&2
        fi
    done
    echo "Total: $total packages across ${#REPOS[@]} repo(s)" >&2
}

# ─── .alp extraction / building ─────────────────────────────

extract_alp() {
    local pkg="$1"
    sed -n '/^---control---$/,/^---data---$/p' "$pkg" | grep -v "^---control---$" | grep -v "^---data---$" | base64 -d > control.tar.xz
    awk '/^---data---$/{found=1; next} found' "$pkg" | base64 -d > data.tar.xz
}

build_alp() {
    local name="$1" version="$2" desc="$3" data_dir="$4" out_file="$5"
    local depends="$6"
    mkdir -p "$WORK_DIR/build"
    cd "$WORK_DIR/build" || exit 1
    tar -cJf data.tar.xz -C "$data_dir" .
    local sha256=""
    command -v sha256sum >/dev/null 2>&1 && sha256=$(sha256sum data.tar.xz | cut -d' ' -f1)
    local deps_json="[]"
    if [ -n "$depends" ]; then
        deps_json="["
        local first=1
        IFS=',' read -ra DEP_ARR <<< "$depends"
        for d in "${DEP_ARR[@]}"; do
            d=$(echo "$d" | tr -d ' ')
            [ -z "$d" ] && continue
            [ "$first" -eq 0 ] && deps_json+=", "
            deps_json+="\"$d\""
            first=0
        done
        deps_json+="]"
    fi
    cat > metadata.json << EOF
{ "name": "$name", "version": "$version", "description": "$desc", "maintainer": "endermanthecookie@gmail.com", "depends": $deps_json, "sha256": "$sha256" }
EOF
    cat > install.sh << 'INSTALL'
#!/bin/bash
echo "Installing $(grep '"name"' metadata.json | cut -d'"' -f4)..."
echo "Package installed successfully!"
INSTALL
    chmod +x install.sh
    tar -cJf control.tar.xz metadata.json install.sh
    { echo "# alpkg package"; echo "name: $name"; echo "version: $version"; echo ""; echo "---control---"; base64 < control.tar.xz; echo ""; echo "---data---"; base64 < data.tar.xz; } > "$out_file"
    rm -rf "$WORK_DIR/build"
}

# ─── Converters ─────────────────────────────────────────────

deb_to_alp() {
    local deb="$1" out="${2:-$(basename "$deb" .deb).alp}"
    echo "Converting $deb -> $out..." >&2
    mkdir -p "$WORK_DIR/deb-extract"
    dpkg-deb -x "$deb" "$WORK_DIR/deb-extract/data" 2>/dev/null
    local name version desc
    name=$(dpkg-deb -f "$deb" Package 2>/dev/null)
    version=$(dpkg-deb -f "$deb" Version 2>/dev/null)
    desc=$(dpkg-deb -f "$deb" Description 2>/dev/null | head -1)
    [ -z "$name" ] && name=$(basename "$deb" .deb)
    [ -z "$version" ] && version="1.0"
    build_alp "$name" "$version" "$desc" "$WORK_DIR/deb-extract/data" "$out"
    rm -rf "$WORK_DIR/deb-extract"
    echo "Created: $out" >&2
}

rpm_to_alp() {
    local rpm="$1" out="${2:-$(basename "$rpm" .rpm).alp}"
    echo "Converting $rpm -> $out..." >&2
    mkdir -p "$WORK_DIR/rpm-extract/data"
    rpm2cpio "$rpm" 2>/dev/null | cpio -idm -D "$WORK_DIR/rpm-extract/data" 2>/dev/null
    local name version desc
    name=$(rpm -qp --queryformat '%{NAME}' "$rpm" 2>/dev/null)
    version=$(rpm -qp --queryformat '%{VERSION}-%{RELEASE}' "$rpm" 2>/dev/null)
    desc=$(rpm -qp --queryformat '%{SUMMARY}' "$rpm" 2>/dev/null)
    [ -z "$name" ] && name=$(basename "$rpm" .rpm)
    [ -z "$version" ] && version="1.0"
    build_alp "$name" "$version" "$desc" "$WORK_DIR/rpm-extract/data" "$out"
    rm -rf "$WORK_DIR/rpm-extract"
    echo "Created: $out" >&2
}

pkg_to_alp() {
    local pkg="$1" out="${2:-$(basename "$pkg" .pkg.tar.zst).alp}"
    echo "Converting $pkg -> $out..." >&2
    mkdir -p "$WORK_DIR/pkg-extract/data"
    tar -xaf "$pkg" -C "$WORK_DIR/pkg-extract/data" 2>/dev/null
    local name version desc=""
    local pkg_info="$WORK_DIR/pkg-extract/data/.PKGINFO"
    if [ -f "$pkg_info" ]; then
        name=$(grep '^pkgname' "$pkg_info" | cut -d= -f2 | tr -d ' ')
        version=$(grep '^pkgver' "$pkg_info" | cut -d= -f2 | tr -d ' ')
        desc=$(grep '^pkgdesc' "$pkg_info" | cut -d= -f2 | sed 's/^ *//')
    fi
    [ -z "$name" ] && name=$(basename "$pkg" .pkg.tar.zst)
    [ -z "$version" ] && version="1.0"
    rm -f "$WORK_DIR/pkg-extract/data/.PKGINFO" "$WORK_DIR/pkg-extract/data/.INSTALL" \
          "$WORK_DIR/pkg-extract/data/.MTREE" "$WORK_DIR/pkg-extract/data/.BUILDINFO" \
          "$WORK_DIR/pkg-extract/data/.CHANGELOG" 2>/dev/null
    build_alp "$name" "$version" "$desc" "$WORK_DIR/pkg-extract/data" "$out"
    rm -rf "$WORK_DIR/pkg-extract"
    echo "Created: $out" >&2
}

# ─── Source fetchers ────────────────────────────────────────

alpkg_fetch() {
    local pkg_name="$1"
    for entry in "${REPOS[@]}"; do
        local rname="${entry%%|*}"
        local rurl="${entry#*|}"
        local cached="$CACHE/$rname-$pkg_name.alp"
        echo "Trying $rname ($rurl)..." >&2
        if download "$rurl/packages/$pkg_name.alp" "$cached" 2>/dev/null; then
            echo "Found in $rname!" >&2
            echo "$cached"
            return 0
        fi
    done
    return 1
}

resolve_deps() {
    local pkg_file="$1"
    shift
    local visited=("$@")
    local name
    name=$(basename "$pkg_file" .alp)

    for v in "${visited[@]}"; do
        [ "$v" = "$name" ] && echo "Error: circular dependency detected ($name)" >&2 && return 1
    done
    visited+=("$name")

    local tmpd="$WORK_DIR/dep-check"
    rm -rf "$tmpd"; mkdir -p "$tmpd"
    (
        cd "$tmpd" || exit 1
        sed -n '/^---control---$/,/^---data---$/p' "$pkg_file" | grep -v "^---control---$" | grep -v "^---data---$" | base64 -d > control.tar.xz
        tar -xJf control.tar.xz 2>/dev/null
    )
    local deps=""
    if [ -f "$tmpd/metadata.json" ]; then
        deps=$(python3 -c "
import json
d = json.load(open('$tmpd/metadata.json'))
for dep in d.get('depends', []):
    print(dep)
" 2>/dev/null)
    fi
    rm -rf "$tmpd"

    for dep in $deps; do
        [ -z "$dep" ] && continue
        if grep -qx "$dep" "$DB/db" 2>/dev/null; then
            echo "Dependency $dep: already installed" >&2
            continue
        fi
        echo "Dependency $dep: not installed, resolving..." >&2
        local dep_file
        dep_file=$(alpkg_fetch "$dep")
        if [ -z "$dep_file" ]; then
            echo "Error: dependency $dep not found in any repository" >&2
            return 1
        fi
        resolve_deps "$dep_file" "${visited[@]}" || return 1
        do_install "$dep_file"
    done
    return 0
}

apt_fetch() {
    local pkg_name="$1"
    if ! command -v apt-cache >/dev/null 2>&1; then
        echo "APT not available on this system" >&2
        return 1
    fi
    local info
    info=$(apt-cache show "$pkg_name" 2>/dev/null)
    [ -z "$info" ] && return 1
    echo "Found in APT repositories!" >&2
    local version desc
    version=$(echo "$info" | grep '^Version:' | head -1 | cut -d' ' -f2)
    desc=$(echo "$info" | grep '^Description-en:\|^Description:' | head -1 | cut -d' ' -f2-)
    echo "  $pkg_name v$version - $desc" >&2
    echo "Downloading..." >&2

    local apt_tmp="$CACHE/apt"
    mkdir -p "$apt_tmp/partial"
    rm -f "$apt_tmp/"*.deb 2>/dev/null

    DEBIAN_FRONTEND=noninteractive \
    apt-get install --download-only -d -y "$pkg_name" \
        -o Dir::Cache="$apt_tmp" \
        -o Dir::Cache::archives="$apt_tmp" \
        -o Dir::State::status=/var/lib/dpkg/status \
        -o APT::Update::Post-Invoke-Success::="" \
        -o DPkg::Post-Invoke::="" >/dev/null 2>&1

    local deb_file
    deb_file=$(ls "$apt_tmp/"*.deb 2>/dev/null | head -1)
    if [ -z "$deb_file" ] || [ ! -f "$deb_file" ]; then
        echo "Error: failed to download $pkg_name" >&2
        return 1
    fi
    local alp_file="$apt_tmp/$pkg_name.alp"
    deb_to_alp "$deb_file" "$alp_file" >/dev/null 2>&1
    rm -f "$deb_file"
    echo "$alp_file"
}

pacman_fetch() {
    local pkg_name="$1"
    if command -v pacman >/dev/null 2>&1; then
        local info
        info=$(pacman -Si "$pkg_name" 2>/dev/null)
        [ -z "$info" ] && return 1
        echo "Found in Pacman repositories!" >&2
        local version desc
        version=$(echo "$info" | grep '^Version' | cut -d: -f2 | tr -d ' ')
        desc=$(echo "$info" | grep '^Description' | cut -d: -f2- | sed 's/^ //')
        echo "  $pkg_name v$version - $desc" >&2
        echo "Downloading..." >&2
        mkdir -p "$CACHE/pacman"
        pacman -Sw --noconfirm "$pkg_name" --cachedir "$CACHE/pacman" 2>/dev/null
        local pkg_file
        pkg_file=$(ls "$CACHE/pacman/"*.pkg.tar.zst 2>/dev/null | head -1)
        if [ -z "$pkg_file" ] || [ ! -f "$pkg_file" ]; then
            echo "Error: failed to download $pkg_name" >&2
            return 1
        fi
        local alp_file="$CACHE/pacman/$pkg_name.alp"
        pkg_to_alp "$pkg_file" "$alp_file" >/dev/null 2>&1
        rm -f "$pkg_file"
        echo "$alp_file"
        return 0
    fi
    return 1
}

# ─── List helpers ───────────────────────────────────────────

list_alpkg() {
    local name_filter="$1"
    for entry in "${REPOS[@]}"; do
        local rname="${entry%%|*}"
        local idx_path
        idx_path=$(repo_index_path "$rname")
        [ ! -f "$idx_path" ] && continue
        local count
        count=$(python3 -c "
import json
with open('$idx_path') as f:
    d = json.load(f)
pkgs = [p for p in d.get('packages',[]) if '$name_filter'.lower() in p.get('name','').lower()]
for p in pkgs:
    print(f\"  [{rname}] {p.get('name')} v{p.get('version')} - {p.get('description')}\")
print(len(pkgs))
" 2>/dev/null)
        local pkg_count
        pkg_count=$(echo "$count" | tail -1)
        echo "$count" | head -n -1
        [ "$pkg_count" = "0" ] && true
    done
}

list_apt() {
    local name_filter="$1"
    command -v apt-cache >/dev/null 2>&1 || return

    if [ -n "$name_filter" ]; then
        apt-cache search "$name_filter" 2>/dev/null | while IFS= read -r line; do
            echo "  $line"
        done
    else
        apt-cache dump 2>/dev/null | grep -E '^Package:|^Version:|^Description-en:' | \
        awk '/^Package:/{p=$2} /^Version:/{v=$2} /^Description-en:/{d=$0; sub(/^Description-en: /,""); if(p) print "  "p" v"v" - "$0; p=""; v=""}' | head -50
    fi
}

list_pacman() {
    local name_filter="$1"
    command -v pacman >/dev/null 2>&1 || { echo "  (pacman not available)"; return; }

    if [ -n "$name_filter" ]; then
        pacman -Sl 2>/dev/null | grep -i "$name_filter" | head -30 | while IFS= read -r line; do
            echo "  $line"
        done
    else
        local count
        count=$(pacman -Sl 2>/dev/null | wc -l)
        echo "  ($count total packages)"
        pacman -Sl 2>/dev/null | head -20 | while IFS= read -r line; do
            echo "  $line"
        done
        [ "$count" -gt 20 ] && echo "  ... and $((count - 20)) more (use --name to filter)"
    fi
}

# ─── do_install ──────────────────────────────────────────────

log_msg() {
    local msg="$*"
    mkdir -p "$DB"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $msg" >> "$LOG"
}

do_install() {
    local pkg_file="$1"
    local skip_deps="$2"
    if [ "$EUID" -ne 0 ]; then
        echo "Error: installation requires root privileges"
        exit 1
    fi
    local name
    name=$(basename "$pkg_file" .alp)

    if [ -z "$skip_deps" ]; then
        echo "Resolving dependencies for $name..."
        resolve_deps "$pkg_file" || { echo "Error: dependency resolution failed"; exit 1; }
    fi

    echo "Installing $name..."
    rm -rf "$WORK_DIR/install"
    mkdir -p "$WORK_DIR/install"
    cd "$WORK_DIR/install" || exit 1
    extract_alp "$pkg_file"
    tar -xJf control.tar.xz 2>/dev/null
    if [ -f metadata.json ]; then
        python3 -c "
import json
d = json.load(open('metadata.json'))
print(f\"Package: {d.get('name', '?')}\")
print(f\"Version: {d.get('version', '?')}\")
print(f\"Description: {d.get('description', '?')}\")
deps = d.get('depends', [])
if deps:
    print(f'Depends: {\", \".join(deps)}')
" 2>/dev/null || {
            echo "Package: $(grep -o '"name": *"[^"]*"' metadata.json | cut -d'"' -f4)"
            echo "Version: $(grep -o '"version": *"[^"]*"' metadata.json | cut -d'"' -f4)"
            echo "Description: $(grep -o '"description": *"[^"]*"' metadata.json | cut -d'"' -f4)"
        }
        local pkg_version
        pkg_version=$(python3 -c "import json; print(json.load(open('metadata.json')).get('version','0'))" 2>/dev/null)
        mkdir -p "$DB/manifests"
        echo "$pkg_version" > "$DB/manifests/$name.version"
    fi
    if [ -f data.tar.xz ]; then
        tar -xJf data.tar.xz -C /
        mkdir -p "$DB/manifests"
        tar -tJf data.tar.xz | sed 's/^/\//' > "$DB/manifests/$name.txt"
    fi
    mkdir -p "$DB"
    if ! grep -qx "$name" "$DB/db" 2>/dev/null; then
        echo "$name" >> "$DB/db"
    fi
    echo "Installed: $name"
    log_msg "install: $name v$pkg_version"
    rm -rf "$WORK_DIR/install"
}

# ─── Commands ───────────────────────────────────────────────

cmd_convert() {
    local file="$1"
    [ -f "$file" ] || { echo "Error: $file not found"; exit 1; }
    case "$file" in
        *.deb) deb_to_alp "$file" ;;
        *.rpm) rpm_to_alp "$file" ;;
        *.pkg.tar.zst) pkg_to_alp "$file" ;;
        *.alp) echo "Already .alp format: $file" ;;
        *) echo "Unknown format. Supported: .deb, .rpm, .pkg.tar.zst"; exit 1 ;;
    esac
}

cmd_list() {
    local name_filter="" platform_filter=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --name) shift; name_filter="$1" ;;
            --platform) shift; platform_filter="$1" ;;
            *) echo "Unknown option: $1"; exit 1 ;;
        esac
        shift
    done

    if [ -n "$platform_filter" ] && [ "$platform_filter" != "alpkg" ] && \
       [ "$platform_filter" != "apt" ] && [ "$platform_filter" != "pacman" ]; then
        echo "Error: --platform must be: alpkg, apt, or pacman"
        exit 1
    fi

    # Installed
    echo "=== Installed ==="
    if [ -f "$DB/db" ] && [ -s "$DB/db" ]; then
        if [ -n "$name_filter" ]; then
            grep -i "$name_filter" "$DB/db" | while IFS= read -r pkg; do
                echo "  $pkg"
            done
        else
            sed 's/^/  /' "$DB/db"
        fi
    else
        echo "  (none)"
    fi
    echo ""

    # alpkg
    if [ -z "$platform_filter" ] || [ "$platform_filter" = "alpkg" ]; then
        echo "=== alpkg ($REPO_URL) ==="
        local alpkg_count
        alpkg_count=$(list_alpkg "$name_filter")
        if [ -n "$alpkg_count" ]; then
            echo "$alpkg_count"
        else
            echo "  (none)"
        fi
        echo ""
    fi

    # APT
    if [ -z "$platform_filter" ] || [ "$platform_filter" = "apt" ]; then
        echo "=== APT ==="
        local apt_count
        apt_count=$(list_apt "$name_filter")
        if [ -n "$apt_count" ]; then
            echo "$apt_count"
        else
            echo "  (none or not available)"
        fi
        echo ""
    fi

    # Pacman
    if [ -z "$platform_filter" ] || [ "$platform_filter" = "pacman" ]; then
        echo "=== Pacman ==="
        local pac_count
        pac_count=$(list_pacman "$name_filter")
        if [ -n "$pac_count" ]; then
            echo "$pac_count"
        else
            echo "  (none or not available)"
        fi
        echo ""
    fi
}

cmd_install() {
    local target="" mode=""
    local alpkg_avail=1 apt_avail=1 pacman_avail=1

    while [ $# -gt 0 ]; do
        case "$1" in
            --alpkg) mode="alpkg" ;;
            --apt) mode="apt" ;;
            --pacman) mode="pacman" ;;
            --*) echo "Unknown option: $1"; exit 1 ;;
            *) target="$1" ;;
        esac
        shift
    done

    [ -z "$target" ] && { echo "Usage: alpkg install <pkg> [--alpkg|--apt|--pacman]"; exit 1; }

    if [ -f "$target" ]; then
        case "$target" in
            *.alp) do_install "$target"; return ;;
            *.deb)
                mkdir -p "$CACHE/convert"
                local conv="$CACHE/convert/$(basename "$target" .deb).alp"
                deb_to_alp "$target" "$conv" || exit 1
                do_install "$conv"; return ;;
            *.rpm)
                mkdir -p "$CACHE/convert"
                local conv="$CACHE/convert/$(basename "$target" .rpm).alp"
                rpm_to_alp "$target" "$conv" || exit 1
                do_install "$conv"; return ;;
            *.pkg.tar.zst)
                mkdir -p "$CACHE/convert"
                local conv="$CACHE/convert/$(basename "$target" .pkg.tar.zst).alp"
                pkg_to_alp "$target" "$conv" || exit 1
                do_install "$conv"; return ;;
        esac
    fi

    if [ "$EUID" -ne 0 ]; then
        echo "Error: remote install requires root privileges"
        exit 1
    fi

    command -v apt-cache >/dev/null 2>&1 || apt_avail=0
    command -v pacman >/dev/null 2>&1 || pacman_avail=0

    local sources=()
    local source_funcs=()
    if [ "$alpkg_avail" -eq 1 ]; then sources+=("alpkg"); source_funcs+=("alpkg_fetch"); fi
    if [ "$apt_avail" -eq 1 ]; then sources+=("apt"); source_funcs+=("apt_fetch"); fi
    if [ "$pacman_avail" -eq 1 ]; then sources+=("pacman"); source_funcs+=("pacman_fetch"); fi

    if [ -n "$mode" ]; then
        case "$mode" in
            alpkg) pkg_file=$(alpkg_fetch "$target") ;;
            apt)   pkg_file=$(apt_fetch "$target") ;;
            pacman) pkg_file=$(pacman_fetch "$target") ;;
        esac
        if [ -z "$pkg_file" ]; then
            echo "Error: $mode: package '$target' not found"
            exit 1
        fi
        do_install "$pkg_file"
        return
    fi

    local failed=()
    while [ ${#sources[@]} -gt 0 ]; do
        local src="${sources[0]}"
        local func="${source_funcs[0]}"
        echo "--- Trying $src ---"
        pkg_file=$($func "$target")
        if [ -n "$pkg_file" ]; then
            do_install "$pkg_file"
            return
        fi
        echo "$src: package '$target' not found"
        failed+=("$src")
        sources=("${sources[@]:1}")
        source_funcs=("${source_funcs[@]:1}")

        [ ${#sources[@]} -eq 0 ] && break

        echo ""
        echo "Which source should I try next?"
        for i in "${!sources[@]}"; do
            echo "  $((i+1))) ${sources[$i]}"
        done
        read -r -p "Choice [1-${#sources[@]}]: " choice
        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#sources[@]}" ]; then
            local idx=$((choice-1))
            local chosen_src="${sources[$idx]}"
            local chosen_func="${source_funcs[$idx]}"
            sources=("$chosen_src" "${sources[@]:0:idx}" "${sources[@]:idx+1}")
            source_funcs=("$chosen_func" "${source_funcs[@]:0:idx}" "${source_funcs[@]:idx+1}")
        else
            echo "Invalid choice, trying next in order"
        fi
    done

    echo ""
    echo "Error: '$target' not found in any available source"
    echo "Tried: ${failed[*]}"
    exit 1
}

cmd_remove() {
    if [ "$EUID" -ne 0 ]; then echo "Error: removal requires root privileges"; exit 1; fi
    local name="$1"
    local manifest="$DB/manifests/$name.txt"
    echo "Removing $name..."
    if [ -f "$manifest" ]; then
        while IFS= read -r file; do
            [ -n "$file" ] && rm -f "$file" 2>/dev/null && echo "Removed: $file"
        done < "$manifest"
        while IFS= read -r file; do
            local dir; dir=$(dirname "$file")
            rmdir --ignore-fail-on-non-empty "$dir" 2>/dev/null || true
        done < "$manifest"
        rm -f "$manifest"
        rm -f "$DB/manifests/$name.version"
    else
        echo "Warning: no manifest found for $name, fallback to basic removal" >&2
        [ -f "/usr/bin/$name" ] && rm -f "/usr/bin/$name" && echo "Removed: /usr/bin/$name"
        [ -f "/usr/local/bin/$name" ] && rm -f "/usr/local/bin/$name" && echo "Removed: /usr/local/bin/$name"
    fi
    [ -f "$DB/db" ] && sed -i "/^$name$/d" "$DB/db" 2>/dev/null
    echo "Removed: $name"
    log_msg "remove: $name"
}

cmd_download() {
    local target="$1"
    [ -z "$target" ] && { echo "Usage: alpkg download <pkg>"; exit 1; }
    echo "Searching for $target..."
    local pkg_file
    pkg_file=$(alpkg_fetch "$target")
    if [ -z "$pkg_file" ]; then
        echo "Error: package '$target' not found in any repository"
        exit 1
    fi
    local dest="./$target.alp"
    cp "$pkg_file" "$dest"
    echo "Downloaded: $dest"
}

cmd_verify() {
    local name="$1"
    [ -z "$name" ] && { echo "Usage: alpkg verify <pkg>"; exit 1; }
    local manifest="$DB/manifests/$name.txt"
    local ver_file="$DB/manifests/$name.version"
    if [ ! -f "$manifest" ]; then
        echo "Error: package '$name' is not installed via alpkg"
        exit 1
    fi
    echo "Verifying $name..."
    local errors=0
    while IFS= read -r file; do
        [ -z "$file" ] && continue
        if [ -f "$file" ]; then
            echo "  OK $file"
        else
            echo "  MISSING $file"
            errors=$((errors + 1))
        fi
    done < "$manifest"
    if [ -f "$ver_file" ]; then
        echo "Version: $(cat "$ver_file")"
    fi
    if [ "$errors" -eq 0 ]; then
        echo "Result: all files present"
    else
        echo "Result: $errors file(s) missing"
        exit 1
    fi
}

cmd_provides() {
    local target="$1"
    [ -z "$target" ] && { echo "Usage: alpkg provides <file>"; exit 1; }
    target=$(echo "$target" | sed 's:^/*:/:')
    echo "Searching for '$target'..."
    local found=0
    for mf in "$DB/manifests/"*.txt; do
        [ -f "$mf" ] || continue
        local pkg
        pkg=$(basename "$mf" .txt)
        if grep -Fx "$target" "$mf" >/dev/null 2>&1; then
            echo "  $pkg: $target"
            found=1
        fi
    done
    if [ "$found" -eq 0 ]; then
        # Try substring match
        for mf in "$DB/manifests/"*.txt; do
            [ -f "$mf" ] || continue
            local pkg
            pkg=$(basename "$mf" .txt)
            if grep -q "$target" "$mf" 2>/dev/null; then
                echo "  $pkg: $(grep "$target" "$mf" | head -3 | tr '\n' ' ')"
                found=1
            fi
        done
    fi
    if [ "$found" -eq 0 ]; then
        echo "No package owns '$target'"
        exit 1
    fi
}

cmd_files() {
    local name="$1"
    local manifest="$DB/manifests/$name.txt"
    if [ -f "$manifest" ]; then
        cat "$manifest"
    else
        echo "Error: no manifest found for package '$name'" >&2
        echo "Is it installed via alpkg?"
        exit 1
    fi
}

find_latest_version() {
    local pkg="$1"
    for entry in "${REPOS[@]}"; do
        local rname="${entry%%|*}"
        local idx_path
        idx_path=$(repo_index_path "$rname")
        [ ! -f "$idx_path" ] && continue
        local ver
        ver=$(python3 -c "
import json
with open('$idx_path') as f:
    data = json.load(f)
for p in data.get('packages', []):
    if p.get('name') == '$pkg':
        print(p.get('version', ''))
" 2>/dev/null)
        [ -n "$ver" ] && echo "$ver" && return 0
    done
    return 1
}

cmd_upgrade() {
    if [ "$EUID" -ne 0 ]; then echo "Error: upgrade requires root privileges"; exit 1; fi
    if [ ! -f "$DB/db" ] || [ ! -s "$DB/db" ]; then
        echo "No packages installed via alpkg."
        return
    fi
    fetch_index
    local upgraded=0
    while IFS= read -r pkg; do
        [ -z "$pkg" ] && continue
        local installed_version="0"
        local ver_file="$DB/manifests/$pkg.version"
        [ -f "$ver_file" ] && installed_version=$(cat "$ver_file")
        local latest_version
        latest_version=$(find_latest_version "$pkg")
        if [ -z "$latest_version" ]; then
            echo "$pkg: not found in any repository, skipping"
            continue
        fi
        if [ "$latest_version" != "$installed_version" ]; then
            echo "Upgrading $pkg: $installed_version -> $latest_version"
            local pkg_file
            pkg_file=$(alpkg_fetch "$pkg")
            if [ -n "$pkg_file" ]; then
                do_install "$pkg_file"
                upgraded=$((upgraded + 1))
            fi
        else
            echo "$pkg: already at latest version ($installed_version)"
        fi
    done < "$DB/db"
    echo ""
    echo "Upgrade complete: $upgraded package(s) upgraded"
    log_msg "upgrade: $upgraded package(s) upgraded"
}

cmd_clean() {
    if [ "$EUID" -ne 0 ]; then echo "Error: clean requires root privileges"; exit 1; fi
    if [ ! -d "$CACHE" ]; then
        echo "Cache directory does not exist."
        return
    fi
    local size
    size=$(du -sh "$CACHE" 2>/dev/null | cut -f1)
    [ -z "$size" ] && size="0B"
    echo "Cleaning alpkg cache ($CACHE)..."
    rm -rf "$CACHE"/*
    echo "Cleaned: $size freed"
}

is_in_any_repo() {
    local pkg="$1"
    for entry in "${REPOS[@]}"; do
        local rname="${entry%%|*}"
        local idx_path
        idx_path=$(repo_index_path "$rname")
        [ ! -f "$idx_path" ] && continue
        local found
        found=$(python3 -c "
import json
with open('$idx_path') as f:
    data = json.load(f)
for p in data.get('packages', []):
    if p.get('name') == '$pkg':
        print('yes')
        break
" 2>/dev/null)
        [ "$found" = "yes" ] && echo "yes" && return 0
    done
    return 1
}

cmd_autoremove() {
    if [ "$EUID" -ne 0 ]; then echo "Error: autoremove requires root privileges"; exit 1; fi
    if [ ! -f "$DB/db" ] || [ ! -s "$DB/db" ]; then
        echo "No packages installed via alpkg."
        return
    fi
    fetch_index 2>/dev/null
    local orphans=()
    while IFS= read -r pkg; do
        [ -z "$pkg" ] && continue
        local found; found=$(is_in_any_repo "$pkg")
        [ "$found" != "yes" ] && orphans+=("$pkg")
    done < "$DB/db"
    if [ ${#orphans[@]} -eq 0 ]; then
        echo "No orphaned packages found."
        return
    fi
    echo "Orphaned packages (not in any repository):"
    for pkg in "${orphans[@]}"; do
        echo "  - $pkg"
    done
    echo ""
    if [ "$YES" -eq 0 ]; then
        read -r -p "Remove these packages? [y/N]: " confirm
    else
        confirm="y"
    fi
    if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
        for pkg in "${orphans[@]}"; do
            cmd_remove "$pkg"
        done
    fi
}

cmd_info() {
    local target="$1"
    if [ -f "$target" ] && [[ "$target" == *.alp ]]; then
        cd /tmp || exit 1; rm -rf alpkg-info; mkdir alpkg-info; cd alpkg-info || exit 1
        sed -n '/^---control---$/,/^---data---$/p' "$target" | grep -v "^---control---$" | grep -v "^---data---$" | base64 -d > control.tar.xz
        tar -xJf control.tar.xz 2>/dev/null
        [ -f metadata.json ] && cat metadata.json
        rm -rf /tmp/alpkg-info
        return
    fi
    for entry in "${REPOS[@]}"; do
        local rname="${entry%%|*}"
        local idx_path
        idx_path=$(repo_index_path "$rname")
        [ ! -f "$idx_path" ] && continue
        local found
        found=$(python3 -c "
import json, sys
with open('$idx_path') as f:
    data = json.load(f)
for p in data.get('packages', []):
    if p.get('name') == '$target':
        print(json.dumps(p, indent=2))
        sys.exit(0)
" 2>/dev/null)
        if [ -n "$found" ]; then
            echo "[$rname]"
            echo "$found"
            return
        fi
    done
    echo "Package '$target' not found in any repository."
    echo "Run 'alpkg update' first if indexes are empty."
    exit 1
}

cmd_search() {
    local query="$1"

    echo "=== alpkg repositories ==="
    list_alpkg "$query"
    echo ""

    echo "=== APT ==="
    if command -v apt-cache >/dev/null 2>&1; then
        apt-cache search "$query" 2>/dev/null | head -20
    else
        echo "  (not available)"
    fi
    echo ""

    echo "=== Pacman ==="
    if command -v pacman >/dev/null 2>&1; then
        pacman -Sl 2>/dev/null | grep -i "$query" | head -20
    else
        echo "  (not available)"
    fi
}

cmd_update() {
    if [ "$EUID" -ne 0 ]; then echo "Error: update requires root privileges"; exit 1; fi
    fetch_index
    command -v apt-get >/dev/null 2>&1 && { echo "Updating APT cache..."; apt-get update 2>/dev/null | tail -1; }
    echo "Done"
}

cmd_repo() {
    local sub="$1"
    mkdir -p "$(dirname "$REPOS_FILE")" 2>/dev/null
    case "$sub" in
        add)
            local rname="$2" rurl="$3"
            [ -z "$rname" ] || [ -z "$rurl" ] && { echo "Usage: alpkg repo add <name> <url>"; exit 1; }
            if grep -q "^$rname|" "$REPOS_FILE" 2>/dev/null; then
                echo "Repository '$rname' already exists. Use 'repo remove $rname' first."
                exit 1
            fi
            echo "$rname|$rurl" >> "$REPOS_FILE"
            echo "Added repository: $rname -> $rurl"
            ;;
        remove)
            local rname="$2"
            [ -z "$rname" ] && { echo "Usage: alpkg repo remove <name>"; exit 1; }
            if [ ! -f "$REPOS_FILE" ]; then
                echo "Error: no repositories configured"
                exit 1
            fi
            if grep -q "^$rname|" "$REPOS_FILE"; then
                grep -v "^$rname|" "$REPOS_FILE" > "${REPOS_FILE}.tmp" && mv "${REPOS_FILE}.tmp" "$REPOS_FILE"
                echo "Removed repository: $rname"
                # Clean up cached index
                rm -f "$CACHE/index-$rname.json"
            else
                echo "Error: repository '$rname' not found"
                exit 1
            fi
            ;;
        set)
            local new_url="$2"
            [ -z "$new_url" ] && { echo "Usage: alpkg repo set <url>"; exit 1; }
            if grep -q "^main|" "$REPOS_FILE" 2>/dev/null; then
                grep -v "^main|" "$REPOS_FILE" > "${REPOS_FILE}.tmp" && mv "${REPOS_FILE}.tmp" "$REPOS_FILE"
            fi
            echo "main|$new_url" >> "$REPOS_FILE"
            echo "Default repository set to: $new_url"
            ;;
        *)
            if [ ! -f "$REPOS_FILE" ]; then
                echo "No repositories configured."
                echo "Default: https://packages-aaron-linux.vercel.app"
            else
                echo "Configured repositories:"
                echo ""
                while IFS='|' read -r name url; do
                    local idx="$CACHE/index-$name.json"
                    local count="?"
                    [ -f "$idx" ] && count=$(grep -c '"name"' "$idx" 2>/dev/null || echo "?")
                    echo "  $name"
                    echo "    URL:   $url"
                    echo "    Cache: $count packages"
                    echo ""
                done < "$REPOS_FILE"
            fi
            echo "Commands:"
            echo "  alpkg repo add <name> <url>     Add a repository"
            echo "  alpkg repo remove <name>        Remove a repository"
            echo "  alpkg repo set <url>            Set default (main) repository"
            command -v apt-cache >/dev/null 2>&1 && echo ""
            command -v apt-cache >/dev/null 2>&1 && echo "APT:     available"
            command -v pacman >/dev/null 2>&1 && echo "Pacman:  available"
            ;;
    esac
}

alpkg_uninstall() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "Error: --uninstall requires root. Use: sudo alpkg --uninstall"
        return 1
    fi
    echo "=== Uninstalling alpkg ==="
    local self; self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
    echo "Removing $self ..."
    rm -f "$self"
    echo "Removing $DB ..."
    rm -rf "$DB"
    echo "Removing $PKG_DIR ..."
    rm -rf "$PKG_DIR"
    echo "Removing $CACHE ..."
    rm -rf "$CACHE"
    echo "Removing /etc/alpkg ..."
    rm -rf /etc/alpkg
    rm -rf /tmp/alpkg-install 2>/dev/null
    echo "alpkg has been removed from this system."
}

if [ $# -lt 1 ]; then help; exit 1; fi

# Parse global flags
ARGS=()
for arg in "$@"; do
    case "$arg" in
        -y|--yes) YES=1 ;;
        --uninstall) alpkg_uninstall; exit $? ;;
        *) ARGS+=("$arg") ;;
    esac
done
set -- "${ARGS[@]}"

mkdir -p "$DB" "$PKG_DIR" "$CACHE" 2>/dev/null

if [ ! -f "$BOOTSTRAP_MARKER" ] && [ "$1" != "bootstrap" ]; then
    echo "alpkg: first run detected. Running bootstrap..."
    bootstrap
    echo "alpkg: bootstrap complete."
fi

case "$1" in
    bootstrap) bootstrap ;;
    install) shift; cmd_install "$@" ;;
    remove) shift; cmd_remove "$@" ;;
    list) shift; cmd_list "$@" ;;
    download) cmd_download "$2" ;;
    verify) cmd_verify "$2" ;;
    provides) cmd_provides "$2" ;;
    files) cmd_files "$2" ;;
    upgrade) cmd_upgrade ;;
    autoremove) cmd_autoremove ;;
    clean) cmd_clean ;;
    info) cmd_info "$2" ;;
    search) cmd_search "$2" ;;
    update) cmd_update ;;
    repo) shift; cmd_repo "$@" ;;
    convert) cmd_convert "$2" ;;
    *) help ;;
esac
